{
	"command": "node lib/index.js",
	"build_path": "./build",
	"stack": "node18",
	"env_variables": {
		"NODE_PATH": "./node_modules"
	},
	"memory": 256,
	"scripts": {
		"preserve": "npm run build",
		"preserve-watch": "npm run build && npm run build:watch & disown;",
		"predeploy": "PRODUCTION=true npm run build"
	},
	"catalyst_auth": true,
	"login_redirect": "/"
}
